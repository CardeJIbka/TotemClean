{
	"schemaVersion": 1,
	"id": "totemclean",
	"version": "${version}",
	"name": "Totem Clean",
	"description": "Removes your own totem of undying activation animation and particles. Keeps the sound.",
	"authors": ["CardeJIbka"],
	"contact": {
		"sources": "https://github.com/CardeJIbka/TotemClean"
	},
	"license": "MIT",
	"icon": "assets/totemclean/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["cardejibka.totemclean.client.TotemCleanClient"]
	},
	"mixins": [
		{
			"config": "totemclean.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": ["26.3"],
		"java": ">=25",
		"fabric-api": "*"
	}
}